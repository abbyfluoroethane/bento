#cloud-config
hostname: "web-1"
users:
  - name: "alice"
    shell: /bin/bash
    lock_passwd: true
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIB6C5rzYtZQoYXsQ2N4YFJmXW4L0Yw1v9uW3o2n8m4Qq alice@laptop"
      - "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABgQCk7example alice@desktop"
package_update: true
packages:
  - qemu-guest-agent
write_files:
  - path: "/etc/systemd/system/bento-damon-reclaim.service"
    owner: "root:root"
    permissions: "0644"
    content: |
      [Unit]
      Description=Bento: return cold guest page cache to the host (DAMON_RECLAIM)
      ConditionPathExists=/sys/module/damon_reclaim/parameters/enabled

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/bin/sh -c 'cd /sys/module/damon_reclaim/parameters && echo 300000000 > min_age && echo Y > skip_anon && echo 1000 > wmarks_high && echo 999 > wmarks_mid && echo 0 > wmarks_low && if [ "$(cat enabled)" = Y ]; then echo Y > commit_inputs; else echo Y > enabled; fi'

      [Install]
      WantedBy=multi-user.target
runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, bento-damon-reclaim.service]
