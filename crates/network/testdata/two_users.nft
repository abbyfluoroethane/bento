# Bento nftables table. Bento owns every rule here; do not edit by hand (SPEC 6.3).
# The whole table is deleted and redefined in one transaction on every change.
add table inet bento
delete table inet bento
table inet bento {
	chain output {
		type filter hook output priority filter; policy accept;
		# rule 1: host to instance on port 22 and the published HTTP ports
		oifname "bento1" ip daddr 10.77.1.2 tcp dport { 22, 80, 3000-9999 } accept
		oifname "bento1" ip daddr 10.77.1.3 tcp dport { 22, 80, 8080 } accept
		oifname "bento1" drop
		oifname "bento2" ip daddr 10.77.2.2 tcp dport { 22, 3000 } accept
		oifname "bento2" drop
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		# rule 3: drop traffic between the bridges of two different users
		iifname "bento1" oifname "bento2" drop
		iifname "bento2" oifname "bento1" drop
		# rule 4: permit traffic within a user's bridge
		iifname "bento1" oifname "bento1" accept
		iifname "bento2" oifname "bento2" accept
		# rule 2: permit instance egress to the internet
		iifname "bento1" accept
		iifname "bento2" accept
	}
	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		# rule 5: masquerade instance egress behind the host address
		ip saddr 10.77.1.0/24 ip daddr != 10.77.0.0/16 masquerade
		ip saddr 10.77.2.0/24 ip daddr != 10.77.0.0/16 masquerade
	}
}
